function salvarPlannerV101(p){configurarPlannerV101_();if(!p.igreja||p.igreja==='Todas')throw new Error('Selecione uma igreja.');const sh=SpreadsheetApp.getActive().getSheetByName(V101.ABA_PLANNER),id=p.id||Utilities.getUuid(),row=findRowV101_(sh,'id',id)||sh.getLastRow()+1,old=row<=sh.getLastRow()?rowObjV101_(sh,row):{},obj={...old,id,igreja:p.igreja,ano:p.ano||new Date().getFullYear(),titulo:p.titulo||'',area:p.area||'Identidade',responsavel:p.responsavel||'',prazo:p.prazo||'',status:p.status||'Não iniciado',criado_em:old.criado_em||new Date(),criado_por:old.criado_por||p.usuario,atualizado_em:new Date(),atualizado_por:p.usuario};setRowByHeadersV101_(sh,row,obj);return obj}
function excluirPlannerV101(p){exigirSenhaV101_(p.usuario,p.senha);const sh=SpreadsheetApp.getActive().getSheetByName(V101.ABA_PLANNER),row=findRowV101_(sh,'id',p.id);if(!row)return{ok:false};sh.deleteRow(row);return{ok:true}}
function listarRequisitosV101(igreja){const base=listarRequisitosV84(),custom=igreja&&igreja!=='Todas'?rowsV101_(SpreadsheetApp.getActive().getSheetByName(V101.ABA_REQ_IGREJA)).filter(x=>x.igreja===igreja):[],map={};custom.forEach(x=>map[x.codigo_requisito]=x);return base.map(r=>({...r,meta_padrao:map[r.codigo_requisito]?Number(map[r.codigo_requisito].meta_padrao||0):Number(r.meta_padrao||0),ativo:map[r.codigo_requisito]?String(map[r.codigo_requisito].ativo).toLowerCase()!=='false':r.ativo,escopo:map[r.codigo_requisito]?'igreja':'global'}))}
function salvarRequisitoV101(p){if(!p.igreja||p.igreja==='Todas')return salvarRequisitoV84(p);configurarRequisitosIgrejaV101_();const sh=SpreadsheetApp.getActive().getSheetByName(V101.ABA_REQ_IGREJA),key=p.igreja+'|'+p.codigo_requisito,rows=rowsV101_(sh);let row=null;rows.forEach((x,i)=>{if(x.igreja+'|'+x.codigo_requisito===key)row=i+2});row=row||sh.getLastRow()+1;setRowByHeadersV101_(sh,row,{igreja:p.igreja,codigo_requisito:p.codigo_requisito,meta_padrao:Number(p.meta_padrao)||0,ativo:String(p.ativo).toLowerCase()!=='false',ultima_atualizacao:new Date(),atualizado_por:p.usuario});return{ok:true,row,escopo:'igreja'}}
