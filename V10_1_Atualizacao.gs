function autenticarV101_(login,senha){const u=rowsV101_(SpreadsheetApp.getActive().getSheetByName('Usuarios')).find(x=>String(x.login).trim().toLowerCase()===String(login).trim().toLowerCase()&&String(x.senha)===String(senha)&&String(x.ativo).toLowerCase()!=='false');return u||null}
function validarSenhaUsuarioV101(login,senha){return !!autenticarV101_(login,senha)}
function exigirSenhaV101_(login,senha){if(!validarSenhaUsuarioV101(login,senha))throw new Error('Senha do usuário ativo inválida.')}
function exigirDevV101_(login,senha){const u=autenticarV101_(login,senha);if(!u||u.funcao!=='Desenvolvedor')throw new Error('Ação exclusiva do Desenvolvedor.')}
function listarUsuariosV101(){migrarUsuariosV101_();return rowsV101_(SpreadsheetApp.getActive().getSheetByName('Usuarios')).map(u=>{u.ativo=String(u.ativo).toLowerCase()!=='false';delete u.senha;return u})}
function salvarUsuarioV101(p){migrarUsuariosV101_();exigirDevV101_(p.usuario_admin,p.senha_admin);const sh=SpreadsheetApp.getActive().getSheetByName('Usuarios'),id=String(p.id||Utilities.getUuid()),row=findRowV101_(sh,'id',id)||sh.getLastRow()+1,old=row<=sh.getLastRow()?rowObjV101_(sh,row):{};if(!String(p.nome||'').trim()||!String(p.login||'').trim())throw new Error('Nome e usuário são obrigatórios.');let fotoUrl=old.foto_url||'',fotoId=old.foto_file_id||'';if(p.foto_base64){const folder=pastaUsuariosV101_(),blob=Utilities.newBlob(Utilities.base64Decode(p.foto_base64),p.foto_mime||'image/jpeg',p.foto_nome||('usuario-'+id+'.jpg')),file=folder.createFile(blob);try{file.setSharing(DriveApp.Access.ANYONE_WITH_LINK,DriveApp.Permission.VIEW)}catch(_e){}fotoId=file.getId();fotoUrl='https://drive.google.com/thumbnail?id='+fotoId+'&sz=w500'}const obj={...old,id,nome:p.nome,funcao:p.funcao||'Secretário(a)',area_atuacao:p.area_atuacao||'',login:p.login,senha:String(p.senha||'').trim()?p.senha:(old.senha||''),ativo:String(p.ativo).toLowerCase()!=='false',foto_url:fotoUrl,foto_file_id:fotoId,modulos:p.modulos||V101_MODULOS.join(','),igrejas:p.igrejas||'',polo:p.polo||'',distrito:p.distrito||'',ultima_atualizacao:new Date(),atualizado_por:p.usuario_admin};if(!obj.senha)throw new Error('Informe a senha para o novo usuário.');setRowByHeadersV101_(sh,row,obj);return {ok:true,id}}
function excluirUsuarioV101(p){exigirDevV101_(p.usuario_admin,p.senha_admin);const sh=SpreadsheetApp.getActive().getSheetByName('Usuarios'),row=findRowV101_(sh,'id',p.id);if(!row)return {ok:false};const u=rowObjV101_(sh,row);if(String(u.login)===String(p.usuario_admin))throw new Error('O Desenvolvedor não pode excluir o próprio acesso ativo.');sh.deleteRow(row);return {ok:true}}
function pastaUsuariosV101_(){const it=DriveApp.getFoldersByName(V101.PASTA_USUARIOS);return it.hasNext()?it.next():DriveApp.createFolder(V101.PASTA_USUARIOS)}
