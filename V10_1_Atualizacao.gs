function ensureSheetV101_(name,headers){const ss=SpreadsheetApp.getActive();let sh=ss.getSheetByName(name);if(!sh)sh=ss.insertSheet(name);if(sh.getLastRow()===0){sh.getRange(1,1,1,headers.length).setValues([headers]);formatarV83_(sh,headers.length);}else ensureHeadersV101_(sh,headers);return sh}
function ensureHeadersV101_(sh,headers){let cur=sh.getRange(1,1,1,Math.max(1,sh.getLastColumn())).getDisplayValues()[0].map(String);headers.forEach(h=>{if(cur.indexOf(h)<0){sh.insertColumnAfter(sh.getLastColumn());sh.getRange(1,sh.getLastColumn()).setValue(h);cur.push(h)}});formatarV83_(sh,sh.getLastColumn())}
function rowsV101_(sh){if(!sh||sh.getLastRow()<2)return[];const v=sh.getDataRange().getDisplayValues(),h=v.shift();return v.filter(r=>r.some(Boolean)).map(r=>{const o={};h.forEach((x,i)=>o[x]=r[i]);return o})}
function rowObjV101_(sh,row){const h=sh.getRange(1,1,1,sh.getLastColumn()).getDisplayValues()[0],v=sh.getRange(row,1,1,sh.getLastColumn()).getDisplayValues()[0],o={};h.forEach((x,i)=>o[x]=v[i]);return o}
function setRowByHeadersV101_(sh,row,obj){const h=sh.getRange(1,1,1,sh.getLastColumn()).getDisplayValues()[0];sh.getRange(row,1,1,h.length).setValues([h.map(k=>obj[k]===undefined?'':obj[k])])}
function findRowV101_(sh,colName,value){const h=sh.getRange(1,1,1,sh.getLastColumn()).getDisplayValues()[0],idx=h.indexOf(colName);if(idx<0)return null;const f=sh.getRange(2,idx+1,Math.max(1,sh.getLastRow()-1),1).createTextFinder(String(value)).matchEntireCell(true).findNext();return f?f.getRow():null}
