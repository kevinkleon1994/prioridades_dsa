function salvarRelatorioV101(p){migrarRelatoriosV101_();const sh=SpreadsheetApp.getActive().getSheetByName(V101.ABA_RELATORIOS),id=p.id||Utilities.getUuid(),row=findRowV101_(sh,'id',id)||sh.getLastRow()+1,old=row<=sh.getLastRow()?rowObjV101_(sh,row):{},obj={...old,id,igreja:p.igreja||old.igreja,ano:p.ano||old.ano,data_hora:old.data_hora||new Date(),usuario:old.usuario||p.usuario,modelo:old.modelo||'manual',resultado_geral:p.resultado_geral||old.resultado_geral||'',relatorio:p.relatorio||'',dificuldades:p.dificuldades||'',editado_em:new Date(),editado_por:p.usuario||''};setRowByHeadersV101_(sh,row,obj);return obj}
