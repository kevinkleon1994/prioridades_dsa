function migrarUsuariosV101_(){const sh=SpreadsheetApp.getActive().getSheetByName('Usuarios')||ensureSheetV101_('Usuarios',['id']);ensureHeadersV101_(sh,['id','nome','funcao','area_atuacao','login','senha','ativo','foto_url','foto_file_id','modulos','igrejas','polo','distrito','ultima_atualizacao','atualizado_por']);const rows=rowsV101_(sh);rows.forEach((u,i)=>{const row=i+2,patch={...u};if(!patch.modulos)patch.modulos=V101_MODULOS.join(',');if(!patch.igrejas)patch.igrejas=patch.funcao==='Administrador'||patch.funcao==='Administrador da Missão'||patch.funcao==='Desenvolvedor'?'Todas':(patch.area_atuacao||'');if(patch.funcao==='Administrador da Missão')patch.funcao='Administrador';if(String(patch.login).toLowerCase()==='admin'&&patch.funcao!=='Desenvolvedor')patch.funcao='Desenvolvedor';setRowByHeadersV101_(sh,row,patch)})}
